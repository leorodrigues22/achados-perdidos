{
  "rules": {
    "itens": {
      ".read": true,
      "$itemId": {
        ".write": "auth != null && ((!data.exists() && newData.child('owner_uid').val() === auth.uid) || (data.exists() && data.child('owner_uid').val() === auth.uid && (!newData.exists() || newData.child('owner_uid').val() === auth.uid)))",
        "nome": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 120)"
        },
        "descricao": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 1200)"
        },
        "categoria": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "tipo": {
          ".validate": "!newData.exists() || (newData.val() === 'perdido' || newData.val() === 'encontrado')"
        },
        "local": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 200)"
        },
        "data": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "contato": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 200)"
        },
        "foto_url": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 900000)"
        },
        "status": {
          ".validate": "!newData.exists() || (newData.val() === 'ativo' || newData.val() === 'resolvido')"
        },
        "owner_uid": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
        },
        "created_at": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
